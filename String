//2. take a string that contain only lowercase and count the maximum number of character 
#include<iostream>
#include<vector>
using namespace std ;
int main(){
    string s;
    cout<<"Enter your string: ";
    cin>>s;
    vector<int>arr(26,0);
    for(int i =0;i<s.size();i++){
        int ch= s[i];
        int ascii =(int)ch;
        arr[ascii-97]++;
    }
    int max=0;
    for(int i=0;i<26;i++){
        if(arr[i]>max){
            max=arr[i];
        }
    }
    for(int i=0;i<26;i++){
        if(arr[i]==max){
            int ascii=i+97;
            char ch=(char)ascii;
            cout<<ch<<" "<<max;
        }
    }
} 

